# reproducible from the URL in the README.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
ds_sanctions/

# Local copy of a notebook WITH outputs, for reading. Never committed:
# outputs hold local paths and entity names.
*.executed.ipynb
